{
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:realtime\" \"npm run dev:recommendation\"",
    "dev:frontend": "cd front-end/novel-nest-books && npm run dev",
    "dev:backend": "cd back-end && go run .",
    "dev:realtime": "cd real-time-service && npm run dev",
    "dev:recommendation": "cd recommendation-service && uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.0"
  }
}

{
  "name": "novelnest-frontend",
  "spec": {
    "kind": "Deployment",
    "spec": {
      "type": "build",
      "buildSettings": {
        "dockerfile": {
          "buildEngine": "kaniko",
          "dockerFilePath": "/Dockerfile",
          "dockerWorkDir": "/"
        }
      },
      "runtimeSettings": {
        "resources": {
          "cpu": "0.2",
          "memory": "512"
        },
        "replicas": {
          "min": 1,
          "max": 3
        },
        "autoscaling": {
          "enabled": true,
          "targetCPU": 70,
          "targetMemory": 80
        }
      },
      "networking": {
        "port": 3000,
        "protocol": "HTTP"
      }
    }
  }
}